{
  "name": "@tahdeth/react-autodraft",
  "version": "1.0.7",
  "description": "A lightweight and type-safe React hook for automatic form state persistence and recovery using localStorage.",
  "author": "Edrees Dbwon eng.edreesysf@gmail.com",
  "license": "MIT",
  "type": "module",
  "main": "./dist/react-auto-draft.umd.cjs",
  "module": "./dist/react-auto-draft.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/react-auto-draft.js",
      "require": "./dist/react-auto-draft.umd.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^18.0.0 || ^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.0.0",
    "vite": "^8.3.0",
    "vite-plugin-dts": "^4.5.4"
  },
  "keywords": [
    "react",
    "react-hook",
    "form-persistence",
    "localstorage",
    "auto-save",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/EdreesYsf/react-auto-draft.git"
  }
}
